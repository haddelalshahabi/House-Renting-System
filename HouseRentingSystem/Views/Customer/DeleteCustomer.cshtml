@model HouseRentingSystem.Models.Customer

<h2>Delete Customer</h2>

<h3>Are you sure you want to delete this customer?</h3>
<div>
    <h4>Customer</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">User ID</dt>
        <dd class="col-sm-10">@Model.User.UserId</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.User.Name</dd>

        <dt class="col-sm-2">Date of Birth</dt>
        <dd class="col-sm-10">@Model.User.DateOfBirth</dd>

        <dt class="col-sm-2">Phone Number</dt>
        <dd class="col-sm-10">@Model.User.PhoneNumber</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.User.Email</dd>

        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.User.Address</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.User.UserId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Overview" class="btn btn-secondary">Cancel</a>
    </form>
</div>