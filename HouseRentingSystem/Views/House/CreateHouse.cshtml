@model HouseRentingSystem.Models.House

<h2>Create New House</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create">
    <!-- Owner's Account Number -->
    <div class="form-group">
        <label asp-for="Owner.AccountNumber"></label><span class="text-danger">*</span>
        <input asp-for="Owner.AccountNumber" class="form-control" />
        <span asp-validation-for="Owner.AccountNumber" class="text-danger"></span>
    </div>

    <!-- Number of Advertisements -->
    <div class="form-group">
        <label asp-for="Owner.NumberOfAdvertisements"></label><span class="text-danger">*</span>
        <input asp-for="Owner.NumberOfAdvertisements" class="form-control" />
        <span asp-validation-for="Owner.NumberOfAdvertisements" class="text-danger"></span>
    </div>

    <!-- Owner's Address -->
    <div class="form-group">
        <label asp-for="Owner.User.Address"></label><span class="text-danger">*</span>
        <input asp-for="Owner.User.Address" class="form-control" />
        <span asp-validation-for="Owner.User.Address" class="text-danger"></span>
    </div>

    <!-- Owner's Email -->
    <div class="form-group">
        <label asp-for="Owner.User.Email"></label><span class="text-danger">*</span>
        <input asp-for="Owner.User.Email" class="form-control" />
        <span asp-validation-for="Owner.User.Email" class="text-danger"></span>
    </div>

    <!-- Order List -->
    <div class="form-group">
        <label asp-for="OrderList"></label><span class="text-danger">*</span>
        <input asp-for="OrderList" class="form-control" />
        <span asp-validation-for="OrderList" class="text-danger"></span>
    </div>

    <!-- Owner's Date of Birth -->
    <div class="form-group">
        <label asp-for="Owner.User.DateOfBirth"></label><span class="text-danger">*</span>
        <input asp-for="Owner.User.DateOfBirth" class="form-control" />
        <span asp-validation-for="Owner.User.DateOfBirth" class="text-danger"></span>
    </div>

    <!-- Owner's Name -->
    <div class="form-group">
        <label asp-for="Owner.User.Name"></label><span class="text-danger">*</span>
        <input asp-for="Owner.User.Name" class="form-control" />
        <span asp-validation-for="Owner.User.Name" class="text-danger"></span>
    </div>

    <!-- Owner's Person ID -->
    <div class="form-group">
        <label asp-for="Owner.User.UserId"></label><span class="text-danger">*</span>
        <input asp-for="Owner.User.UserId" class="form-control" />
        <span asp-validation-for="Owner.User.UserId" class="text-danger"></span>
    </div>

    <!-- Owner's Phone Number -->
    <div class="form-group">
        <label asp-for="Owner.User.PhoneNumber"></label><span class="text-danger">*</span>
        <input asp-for="Owner.User.PhoneNumber" class="form-control" />
        <span asp-validation-for="Owner.User.PhoneNumber" class="text-danger"></span>
    </div>

    <!-- List of Houses -->
    <div class="form-group">
        <label asp-for="Owner.ListOfHouses"></label><span class="text-danger">*</span>
        <input asp-for="Owner.ListOfHouses" class="form-control" />
        <span asp-validation-for="Owner.ListOfHouses" class="text-danger"></span>
    </div>

    <!-- Address -->
    <div class="form-group">
        <label asp-for="Address"></label><span class="text-danger">*</span>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <!-- City -->
    <div class="form-group">
        <label asp-for="City"></label><span class="text-danger">*</span>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>

    <!-- Area -->
    <div class="form-group">
        <label asp-for="Area"></label>
        <input asp-for="Area" class="form-control" />
        <span asp-validation-for="Area" class="text-danger"></span>
    </div>

    <!-- Price -->
    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" type="number" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <!-- NumberOfRooms -->
    <div class="form-group">
        <label asp-for="NumberOfRooms"></label>
        <input asp-for="NumberOfRooms" class="form-control" type="number" />
        <span asp-validation-for="NumberOfRooms" class="text-danger"></span>
    </div>

    <!-- House Description -->
    <div class="form-group">
        <label asp-for="Description"></label><span class="text-danger">*</span>
        <textarea class="form-control" asp-for="Description" rows="5" required></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <!-- LeaseDuration -->
    <div class="form-group">
        <label asp-for="LeaseDuration"></label>
        <input asp-for="LeaseDuration" class="form-control" />
        <span asp-validation-for="LeaseDuration" class="text-danger"></span>
    </div>

    <!-- UtilitiesIncluded -->
    <div class="form-group">
        <label asp-for="UtilitiesIncluded"></label>
        <input asp-for="UtilitiesIncluded" class="form-control" type="checkbox" />
    </div>

    <!-- HasParking -->
    <div class="form-group">
        <label asp-for="HasParking"></label>
        <select asp-for="HasParking" class="form-control">
            <option value="True">YES</option>
            <option value="False">NO</option>
        </select>
    </div>

    <!-- IsFurnished -->
    <div class="form-group">
        <label asp-for="IsFurnished"></label>
        <select asp-for="IsFurnished" class="form-control">
            <option value="True">YES</option>
            <option value="False">NO</option>
        </select>
    </div>


    <!-- PetFriendly -->
    <div class="form-group">
        <label asp-for="PetFriendly"></label>
        <select asp-for="PetFriendly" class="form-control">
            <option value="True">YES</option>
            <option value="False">NO</option>
        </select>
    </div>

    <!-- Amenities -->
    <div class="form-group">
        <label asp-for="Amenities"></label>
        <textarea asp-for="Amenities" class="form-control"></textarea>
        <span asp-validation-for="Amenities" class="text-danger"></span>
    </div>

    <!-- ImageUrl -->
    <div class="form-group">
        <label for="ImageUrl">Upload Image :</label>
        <input asp-for="ImageUrl">
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Table" class="btn btn-secondary">Cancel</a>
</form>