@model HouseRentingSystem.Models.House

<h2>Delete House</h2>

<h3>Are you sure you want to delete this house?</h3>
<div>
    <hr />
    <dl class="row">
        <!-- House Id -->
        <dt class="col-sm-2">House Id</dt>
        <dd class="col-sm-10">@Model.HouseId</dd>

        <!-- Address -->
        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.Address</dd>

        <!-- City -->
        <dt class="col-sm-2">City</dt>
        <dd class="col-sm-10">@Model.City</dd>

        <!-- Area -->
        <dt class="col-sm-2">Area</dt>
        <dd class="col-sm-10">@Model.Area</dd>

        <!-- Price -->
        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Price</dd>

        <!-- Number of Rooms -->
        <dt class="col-sm-2">Number of Rooms</dt>
        <dd class="col-sm-10">@Model.NumberOfRooms</dd>

        <!-- Available -->
        <dt class="col-sm-2">Available</dt>
        <dd class="col-sm-10">@Model.Available</dd>

        <!-- Parking -->
        <dt class="col-sm-2">Parking</dt>
        <dd class="col-sm-10">@Model.HasParking</dd>

        <!-- Furnished -->
        <dt class="col-sm-2">Furnished</dt>
        <dd class="col-sm-10">@Model.IsFurnished</dd>

        <!-- Description -->
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <!-- Image URL -->
        <dt class="col-sm-2">Image</dt>
        <dd class="col-sm-10"><img src="@Model.ImageUrl" alt="Image of the house" width="200px"></dd>

        <!-- Pet Friendly -->
        <dt class="col-sm-2">Pet Friendly</dt>
        <dd class="col-sm-10">@Model.PetFriendly</dd>

        <!-- Amenities -->
        <dt class="col-sm-2">Amenities</dt>
        <dd class="col-sm-10">@Model.Amenities</dd>

        <!-- LeaseDuration -->
        <dt class="col-sm-2">LeaseDuration</dt>
        <dd class="col-sm-10">@Model.LeaseDuration</dd>

        <!-- UtilitiesIncluded -->
        <dt class="col-sm-2">UtilitiesIncluded</dt>
        <dd class="col-sm-10">@Model.UtilitiesIncluded</dd>
    </dl>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.HouseId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Table" class="btn btn-secondary">Cancel</a>
    </form>
</div>