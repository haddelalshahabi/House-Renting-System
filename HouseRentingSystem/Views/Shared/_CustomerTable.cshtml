@model IEnumerable<HouseRentingSystem.Models.Customer>

    <div class="container">
        <table class='table table-striped'>
            <tr>
                <th>CustomerID</th>
                <th>Name</th>
                <th>Address</th>
                <th>Birthdate</th>
                <th>PhoneNumber</th>
                <th>Order</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>

            @foreach (var customer in Model)
            {
                <tr>
                    <td>@customer.Name</td>
                    <td>@customer.Birthdate.ToString("dd/MM/yyyy")</td>
                    <td>@customer.Email</td>
                    <td>@customer.PhoneNumber</td>
                    <td>@customer.Address</td>

                    <td>
                        @if (customer.Orders != null && customer.Orders.Any())
                        {
                            <div class="orders-list">
                                Orders: @string.Join(", ", customer.Orders.Select(order => $"Order{order.OrderId}"))
                            </div>
                        }
                        else
                        {
                            <span class="no-orders">No Orders linked</span>
                        }
                    </td>

                    <td class="action-buttons">
                        <a asp-action="UpdateConfirmed" asp-route-id="@customer.CustomerId" class="btn btn-sm btn-primary">Update</a>
                        <a asp-action="DeleteConfirmed" asp-route-id="@customer.CustomerId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </table>
    </div>