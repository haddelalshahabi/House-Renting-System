<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="~/lib/bootstrap/js/bootstrap.js"></script>
    <script src="~/lib/jquery/jquery.js"></script>
    <script src="~/lib/jquery-validate/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="https://kit.fontawesome.com/0f8b312258.js" crossorigin="anonymous"></script>
</head>
<body>
    <header>
        <div class="container-fluid">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto">
                    <!-- Logo Icon -->
                    <i class="fa-brands fa-staylinked">Stay Spaces</i>
                </div>
                <div class="col-md-5">
                    <input type="text" class="form-control" placeholder="Search...">
                </div>
                <div class="col-auto">
                    <!-- Language Icon -->
                    <a href="#" role="button" id="languageButton">
                        <i class="fa-solid fa-globe"></i>
                    </a>
                </div>
                <div class="col-auto">
                    <!-- Profile Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-bars"></i> <i class="fa-solid fa-user-circle"></i>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="profileDropdown">
                            <li><a class="dropdown-item" href="#">Registrer deg</a></li>
                            <li><a class="dropdown-item" href="#">Logg inn</a></li>
                            <li><a class="dropdown-item" href="#">Legg ut hjemmet ditt på Airbnb</a></li>
                            <li><a class="dropdown-item" href="#">Hjelpesenteret</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="row bg-light py-2">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <div class="container-fluid">
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="navbarNav">
                            <ul class="navbar-nav me-auto">
                                <li class="nav-item">
                                    <a class="nav-link" href="#">Hytte</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">Kupler</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">Nær skiløype/-bakke</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">Herskapshus</a>
                                </li>
                            </ul>
                            <!-- Filter options -->
                            <div class="d-flex align-items-center">
                                <select class="form-select me-2" aria-label="Filter by price">
                                    <option selected>Price</option>
                                    <option value="1">Low to High</option>
                                    <option value="2">High to Low</option>
                                </select>
                                <!-- Single Filter button on the right side -->
                                <button class="btn btn-outline-secondary">Filter</button>
                            </div>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-dark">
        <div class="container">
            <div class="row py-4">
                <div class="col-md-4">
                    <h5>Støtte</h5>
                    <!-- Add sub-information here -->
                </div>
                <div class="col-md-4">
                    <h5>Vertskap</h5>
                    <!-- Add sub-information here -->
                </div>
                <div class="col-md-4">
                    <h5>Stay Spaces</h5>
                    <!-- Add sub-information here -->
                </div>
            </div>
            <hr>
            <div class="row py-2">
                <div class="col-12">
                    <small>&copy; 2023 Stay Spaces, Inc. · Personvern · Vilkår · Firmaopplysninger</small>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>