<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - House Renting System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <!-- Logo to the left -->
                <a class="navbar-brand" href="#">
                    <img src="path_to_logo_image.png" alt="Logo" width="30" height="30" class="d-inline-block align-text-top"> <!-- Add your logo path -->
                    House Renting System
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Navigation links in the center -->
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Item" asp-action="Table">Items</a>
                        </li>
                        <!-- Add other navigation links if needed -->
                    </ul>

                    <!-- Profile icon to the right -->
                    <div class="navbar-nav">
                        <a href="#" class="nav-link">
                            <img src="path_to_profile_icon.png" alt="Profile Icon" width="30" height="30" class="rounded-circle"> <!-- Add your profile icon path -->
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted bg-dark">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5>Quick Links</h5>
                    <!-- Add your quick links here -->
                </div>
                <div class="col-md-4">
                    <h5>Contact Us</h5>
                    <!-- Add your contact details here -->
                </div>
                <div class="col-md-4">
                    <h5>Follow Us</h5>
                    <!-- Add your social media icons here -->
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    &copy; 2023 - House Renting System - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>