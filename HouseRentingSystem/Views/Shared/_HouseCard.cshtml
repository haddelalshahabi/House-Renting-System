@model HouseRentingSystem.Models.House

    <div class="col">
        <div>
            <img src="@Model.ImageUrl" class="card-img-top" alt="Picture Not Found">
            <div>
                <div class="d-flex justify-content-between mt-2">
                    <h5 class="text-start">
                        @Model.Address
                        @Model.City
                    </h5>

                    <h5 class="text-nowrap">
                        @Model.Price.ToString("0.00 NOK")
                    </h5>
                </div>

                <button type="button" class="btn btn-info">
                    <a asp-controller="House"
                       asp-action="Overview"
                       asp-route-id="@Model.HouseId">
                        More
                    </a>
                </button>
            </div>
        </div>
    </div>

